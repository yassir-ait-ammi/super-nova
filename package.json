{
  "name": "nova-saas",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @nova/db migrate",
    "db:migrate:deploy": "pnpm --filter @nova/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @nova/db migrate:dev",
    "db:seed": "pnpm --filter @nova/db seed",
    "db:test:setup": "pnpm --filter @nova/db setup:test-db",
    "db:generate": "pnpm --filter @nova/db generate",
    "bootstrap:platform-admin": "pnpm --filter @nova/api bootstrap:platform-admin"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  }
}
