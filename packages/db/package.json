{
  "name": "@nova/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "migrate": "tsx scripts/bootstrap-roles.ts && prisma migrate deploy",
    "migrate:deploy": "tsx scripts/bootstrap-roles.ts && prisma migrate deploy",
    "migrate:dev": "tsx scripts/bootstrap-roles.ts && prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "reset": "tsx scripts/bootstrap-roles.ts && prisma migrate reset --force",
    "setup:test-db": "tsx scripts/setup-test-db.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma scripts --max-warnings=0"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "pg": "^8.13.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "@types/pg": "^8.11.10",
    "@types/node": "^20.16.10"
  }
}
