# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored — never commit it. Everything below is either a
# placeholder or a value that's safe to share (like the local docker-compose
# Postgres credentials, which only ever exist on your machine).

NODE_ENV=development

# ---------------------------------------------------------------------------
# Web / API
# ---------------------------------------------------------------------------

WEB_PORT=3000
API_PORT=4000
# Same-origin proxy target — see apps/web/next.config.js. Only needs to
# change if the API runs on a different host/port than the default below.
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Postgres (docker-compose.yml's local `postgres` service — port 5433 on the
# host to avoid clashing with a Postgres already running on 5432)
# ---------------------------------------------------------------------------

POSTGRES_ROOT_URL=postgres://nova_root:nova_root_local_only@localhost:5433/nova

# nova_migrator: schema owner, BYPASSRLS — migration/seed/CI-only, never
# used by the running API. nova_app: the sole runtime credential, owns
# nothing, NOBYPASSRLS. Both roles are created by `pnpm db:migrate` (see
# packages/db/scripts/bootstrap-roles.ts) using the passwords in these URLs
# — change the passwords below to whatever you like before first running
# db:migrate; they don't need to mean anything.
MIGRATOR_DATABASE_URL=postgres://nova_migrator:change-me-migrator@localhost:5433/nova
APP_DATABASE_URL=postgres://nova_app:change-me-app@localhost:5433/nova

# ---------------------------------------------------------------------------
# Session / crypto secrets — generate real random values for these two,
# e.g.:  openssl rand -base64 40            (SESSION_CSRF_SECRET)
#        openssl rand -base64 32            (EMAIL_PAYLOAD_ENC_KEY, must
#                                             decode to exactly 32 bytes)
# ---------------------------------------------------------------------------

SESSION_CSRF_SECRET=replace-with-a-random-string-at-least-32-characters-long
EMAIL_PAYLOAD_ENC_KEY=replace-with-a-base64-encoded-32-byte-key

# ---------------------------------------------------------------------------
# Platform Administrator bootstrap (pnpm bootstrap:platform-admin) — no-op
# once any Platform Administrator exists. Leave PASSWORD unset to have a
# compliant one generated and printed once at bootstrap time.
# ---------------------------------------------------------------------------

PLATFORM_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# Transactional email — pick ONE adapter. Automated tests always use
# "recording" regardless of this setting (see .env.test).
# ---------------------------------------------------------------------------

# EMAIL_ADAPTER=recording   # default: captured in-process, nothing sent
# EMAIL_ADAPTER=resend      # real email via Resend — requires a verified
#                           # sending domain/address (see README)
# EMAIL_ADAPTER=gmail       # real email via a Gmail account over SMTP — no
#                           # domain needed, just a Google account
EMAIL_ADAPTER=recording

# --- Resend (EMAIL_ADAPTER=resend) ---
# RESEND_API_KEY=
# RESEND_SENDER_EMAIL=

# --- Gmail SMTP (EMAIL_ADAPTER=gmail) ---
# 1. Enable 2-Step Verification on the Google account you want to send from.
# 2. Create an App Password: myaccount.google.com/apppasswords
#    (needs 2-Step Verification on first; pick "Mail" / "Other" as the app).
# 3. Paste that 16-character password below (spaces are fine either way).
# GMAIL_USER=your-account@gmail.com
# GMAIL_APP_PASSWORD=
# GMAIL_SENDER_NAME=NOVA
